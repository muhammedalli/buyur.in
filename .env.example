NEXT_PUBLIC_PB_URL
NEXT_PUBLIC_ROOT_DOMAIN=

POCKETBASE_API_URL=
POCKETBASE_ADMIN_TOKEN=

MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=

PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=

# Yönetim paneli (admin.buyur.in) oturum çerezini şifreleyen sır — en az 32
# karakter. Boşsa admin girişi kapalıdır. Üretmek için: openssl rand -base64 48
# Değiştirilirse bütün admin oturumları düşer.
ADMIN_SESSION_SECRET=

ANALYTICS_CRON_SECRET=
ANALYTICS_TIMING

OPENAI_API_KEY=

# Google Search Console doğrulama kodu (opsiyonel; boşsa meta etiketi basılmaz)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# AI menü aktarımı (sunucu tarafı — istemciye asla gönderilmez)
OPENAI_MENU_MODEL=

# Ürün görseli sağlayıcıları — hepsi ticari kullanıma açık lisanslıdır.
# Wikimedia Commons ve Openverse anahtar istemez ve her zaman devrededir;
# aşağıdaki anahtarlar opsiyoneldir, tanımlandıkça sonuç havuzu genişler.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Openverse anahtarsız da çalışır; token yalnızca hız sınırını yükseltir.
OPENVERSE_API_TOKEN=

# Brevo — kayıt doğrulama (OTP) ve karşılama e-postaları (sunucu tarafı).
# Anahtar ham "xkeysib-..." ya da Brevo panelinin verdiği base64 sarmal olabilir.
BREVO_API_KEY=
# Boşsa noreply@<NEXT_PUBLIC_ROOT_DOMAIN> kullanılır.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
